  "usage_instructions": {
    "ru": {
      "title": "Инструкция по использованию патчей",
      "steps": [
        "1. Скопируйте нужный патч из примеров выше",
        "2. Откройте админ-панель (admin_panel.php)",
        "3. Перейдите в раздел 'Система патчей'",
        "4. Вставьте данные патча в соответствующие поля",
        "5. Нажмите 'Предпросмотр' для проверки",
        "6. Нажмите 'Применить патч' для внедрения изменений"
      ],
      "notes": [
        "⚠️ Перед применением патча обязательно сделайте резервную копию данных",
        "📝 Все патчи логируются в системе для отслеживания изменений", 
        "🔍 Используйте функцию предпросмотра для проверки корректности патча",
        "🚫 Не применяйте патчи на продакшен сервере без предварительного тестирования"
      ]
    }
  },
  "api_usage": {
    "curl_example": {
      "description": "Пример применения патча через cURL",
      "command": "curl -X POST -H 'Content-Type: application/x-www-form-urlencoded' -d 'action=apply_patch&patch_data={\"version\":\"1.0.1\",\"description\":\"Тестовый патч\",\"changes\":[{\"type\":\"add_teleport\",\"data\":{\"name\":\"Тест\",\"x\":0,\"y\":64,\"z\":0,\"world\":\"default\",\"description\":\"Тестовый телепорт\"}}]}' http://yourserver.com/rp_teleport_plugin.php"
    },
    "php_example": {
      "description": "Пример применения патча через PHP",
      "code": "<?php\n$patch_data = [\n    'version' => '1.0.1',\n    'description' => 'Тестовый патч',\n    'changes' => [\n        [\n            'type' => 'add_teleport',\n            'data' => [\n                'name' => 'Тест',\n                'x' => 0,\n                'y' => 64,\n                'z' => 0,\n                'world' => 'default',\n                'description' => 'Тестовый телепорт'\n            ]\n        ]\n    ]\n];\n\n$postData = [\n    'action' => 'apply_patch',\n    'patch_data' => json_encode($patch_data)\n];\n\n$context = stream_context_create([\n    'http' => [\n        'method' => 'POST',\n        'header' => 'Content-Type: application/x-www-form-urlencoded',\n        'content' => http_build_query($postData)\n    ]\n]);\n\n$result = file_get_contents('http://yourserver.com/rp_teleport_plugin.php', false, $context);\n$response = json_decode($result, true);\n\nif ($response['success']) {\n    echo 'Патч успешно применён!';\n} else {\n    echo 'Ошибка: ' . $response['message'];\n}\n?>"
    }
  }
